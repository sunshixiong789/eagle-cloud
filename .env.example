# Eagle 本地开发环境变量配置
# 复制此文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）

# ===========================================
# application-dev.yml (MySQL) 使用的变量
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eagle
DB_USERNAME=root
DB_PASSWORD=

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# application-local.yml (H2) 使用的变量
# ===========================================
H2_DB_PATH=./db/eagle
H2_DB_USERNAME=root
H2_DB_PASSWORD=123456

# ===========================================
# 第三方服务配置（可选）
# ===========================================

# 微信小程序
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 微信 PC 扫码登录（微信开放平台）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback

# 微信 H5 公众号登录
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# 阿里云短信服务
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===========================================
# 管理员账户（可选，默认 admin/123456）
# ===========================================
EAGLE_ADMIN_PASSWORD=123456

# ===========================================
# 基础设施服务（可选）
# ===========================================
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
SENTINEL_DASHBOARD=localhost:8858
