# =============================================================================
# Eagle Cloud · dev 环境完整配置 —— 模板（自包含）
# -----------------------------------------------------------------------------
# 用法：cp .env.dev.example .env.dev，再填机密值。.env.dev 已 gitignore。
#
# IDEA 一键部署：Docker Compose 运行配置 → Compose files=docker-compose.yml，
#                Environment variables file=.env.dev，点绿色三角即部署。
# 命令行：docker compose --env-file .env.dev up -d
# =============================================================================

# Spring profile：dev 开发
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL（dev 用本机 docker 的 postgres 服务）──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eagle_system
AUTH_DB_NAME=eagle_auth
PAYMENT_DB_NAME=eagle_payment
DB_USERNAME=eagle
DB_PASSWORD=eagle123456
DB_POOL_MAX=80
DB_POOL_MIN=20

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456
REDIS_DATABASE=0
REDIS_POOL_MAX_ACTIVE=96
REDIS_POOL_MAX_IDLE=32
REDIS_POOL_MIN_IDLE=8
REDIS_POOL_MAX_WAIT=2000ms

# ── Nacos ──
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me
NACOS_REGISTER_IP=

# ── RocketMQ ──
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_ENDPOINTS=rocketmq-proxy:8081
ROCKETMQ_TOPIC_ENV_PREFIX=

# ── Gateway → Auth + Sentinel Dashboard ──
AUTH_SERVER_URL=http://auth:9090
SENTINEL_DASHBOARD=sentinel-dashboard:8858

# ── 初始管理员（PASSWORD 无默认值，必填）──
EAGLE_ADMIN_USERNAME=admin
EAGLE_ADMIN_NAME=系统管理员
EAGLE_ADMIN_EMAIL=admin@eagle.com
EAGLE_ADMIN_PASSWORD=change-me-strong-password

# ── 安全 / OAuth ──
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
EAGLE_JWT_KEYSTORE_PASSWORD=eagle-jwt-dev-2026
EAGLE_REMEMBER_ME_KEY=change-me-remember-me-key
EAGLE_OAUTH_ISSUER=http://localhost:8080
EAGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/oauth2/callback
EAGLE_OAUTH_POST_LOGOUT_REDIRECT_URIS=http://localhost:8000/auth/oauth2/logout/callback
EAGLE_OAUTH_JWK_SET_URI=http://auth:9090/oauth2/jwks

# Gateway CORS：dev 可用通配
CORS_ALLOWED_ORIGINS=*

# ── 淘宝登录（enabled=true 才装配 TaobaoClient）──
TAOBAO_APP_ENABLED=false
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_APP_SIGN_METHOD=md5

# ── Apple Sign In（dev 默认关闭；填完 Key ID、.p8 和加密密钥后改为 true）──
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=com.shengxinfast.app
APPLE_TEAM_ID=NBSUMG9U89
APPLE_KEY_ID=
# 将 .p8 内容压成一行，并用 \n 表示换行；禁止提交真实值。
APPLE_PRIVATE_KEY=
# refresh token 字段级加密密钥；APPLE_AUTH_ENABLED=true 时必填。生成方式：openssl rand -base64 32
# EAGLE_ENCRYPT_SECRET_KEY=

# ── 短信（SMS_PROVIDER: aliyun / tencent / hnsls；SMS_SIGN_NAME 为空时只打印日志不发送）──
SMS_PROVIDER=hnsls
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
HNSLS_SMS_CONTENT_TEMPLATE=您的验证码是{code}，5分钟内有效。
HNSLS_SMS_SEND_URL=https://xapi.hnsls.com.cn/eums/sms/utf8/send.do
HNSLS_SMS_CHARSET=UTF-8
HNSLS_SMS_CONNECT_TIMEOUT_MS=8000
HNSLS_SMS_READ_TIMEOUT_MS=10000

# ── 微信登录（按需填写，留空 = 禁用对应渠道）──
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback
