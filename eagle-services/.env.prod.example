# =============================================================================
# Eagle Cloud · prod 环境完整配置 —— 模板（自包含）
# -----------------------------------------------------------------------------
# 用法：cp .env.prod.example .env.prod，把外部托管基础设施端点 / 凭据填进来。
#       .env.prod 已 gitignore，禁止提交。
#
# prod compose 中大量变量用 ${VAR:?...} 强校验：缺失即启动失败（fail-fast）。
#
# IDEA 一键部署：Docker Compose 运行配置 → Compose files=docker-compose.prod.yml，
#                Environment variables file=.env.prod，点绿色三角即部署。
# 命令行：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# Spring profile：prod 生产
SPRING_PROFILES_ACTIVE=prod

# 镜像 tag（prod compose 用 ${EAGLE_IMAGE_TAG:-1.0.0}）
EAGLE_IMAGE_TAG=1.0.0

# ── 外部托管 PostgreSQL（阿里云 RDS / 腾讯云 TDSQL-PG / 自建）──
DB_HOST=your-rds-host
DB_PORT=5432
DB_NAME=eagle_system
AUTH_DB_NAME=eagle_auth
DB_USERNAME=eagle
DB_PASSWORD=change-me
DB_POOL_MAX=80
DB_POOL_MIN=20

# ── 外部托管 Redis（阿里云 Tair / 腾讯云 Redis / 自建）──
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_POOL_MAX_ACTIVE=96
REDIS_POOL_MAX_IDLE=32
REDIS_POOL_MIN_IDLE=8
REDIS_POOL_MAX_WAIT=2000ms

# ── 外部托管 Nacos（阿里云 MSE / 自建集群）──
NACOS_SERVER_ADDR=your-nacos-host:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me
NACOS_REGISTER_IP=

# ── 外部托管 RocketMQ（阿里云 MQ / 腾讯云 TDMQ / 自建）：5.x gRPC 连 Proxy:8081 ──
ROCKETMQ_ENDPOINTS=your-rocketmq-proxy:8081
ROCKETMQ_NAME_SERVER=your-rocketmq-namesrv:9876
# 多环境共用 MQ 集群时用前缀隔离 topic；独立集群可留空
ROCKETMQ_TOPIC_ENV_PREFIX=prod_

# ── 初始管理员（PASSWORD 必填）──
EAGLE_ADMIN_USERNAME=admin
EAGLE_ADMIN_NAME=系统管理员
EAGLE_ADMIN_EMAIL=admin@eagle.com
EAGLE_ADMIN_PASSWORD=change-me-strong-password

# ── 安全 / OAuth（必填）──
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
EAGLE_JWT_KEYSTORE_PASSWORD=change-me-strong-keystore-password
EAGLE_REMEMBER_ME_KEY=change-me-high-entropy-random-string
# 对外稳定入口（LB / 网关域名）
EAGLE_OAUTH_ISSUER=https://api.example.com
EAGLE_OAUTH_REDIRECT_URIS=https://app.example.com/auth/oauth2/callback
EAGLE_OAUTH_POST_LOGOUT_REDIRECT_URIS=https://app.example.com/auth/oauth2/logout/callback
EAGLE_OAUTH_JWK_SET_URI=http://auth:9090/oauth2/jwks

# Gateway CORS：prod 禁止通配，必须显式列出业务前端域名
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Sentinel Dashboard 鉴权（首次启动后务必覆盖默认 sentinel/sentinel）──
# SENTINEL_JAVA_OPTS=-server -XX:+UseG1GC -Xms512m -Xmx768m -Dserver.port=8858 -Dcsp.sentinel.dashboard.server=localhost:8858 -Dproject.name=sentinel-dashboard -Dsentinel.dashboard.auth.username=admin -Dsentinel.dashboard.auth.password=change-me

# ── Gateway Sentinel 限流（prod compose 已含更高默认；如需调整再放开）──
# EAGLE_SENTINEL_GLOBAL_QPS=3600
# EAGLE_SENTINEL_GLOBAL_BURST=600
# EAGLE_SENTINEL_AUTH_QPS=1200
# EAGLE_SENTINEL_AUTH_BURST=200
# EAGLE_SENTINEL_SMS_QPS=120
# EAGLE_SENTINEL_SMS_BURST=30

# ── 淘宝登录（按需）──
TAOBAO_APP_ENABLED=false
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_APP_SIGN_METHOD=md5

# ── 短信（prod 真值）──
SMS_PROVIDER=hnsls
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou
HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
HNSLS_SMS_CONTENT_TEMPLATE=您的验证码是{code}，5分钟内有效。
HNSLS_SMS_SEND_URL=https://xapi.hnsls.com.cn/eums/sms/utf8/send.do
HNSLS_SMS_CHARSET=UTF-8
HNSLS_SMS_CONNECT_TIMEOUT_MS=5000
HNSLS_SMS_READ_TIMEOUT_MS=10000

# ── 微信登录（按需填写，留空 = 禁用对应渠道）──
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=
