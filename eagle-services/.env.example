# =============================================================================
# Eagle Cloud · Docker Compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 适用：在服务器/容器主机上用 docker compose 部署 eagle-services 时使用
# 区别：项目根 /.env.example 用于本地 IDE 开发（host 都是 localhost）；
#       本文件用于容器化部署（host 走 docker compose 服务名）
#
# 用法：
#   1) cd eagle-services
#   2) cp .env.example .env
#   3) 按服务器实际情况修改下方各项（标注 *必填* 的必须替换）
#   4) docker compose up -d
# 注意：.env 已被 .gitignore 阻挡，不要提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# Spring 通用
# -----------------------------------------------------------------------------
# 激活的 profile（对应 application-{profile}.yml）：
#   prod  — 生产部署：Swagger 关闭、日志收紧、HikariCP 泄漏检测、CORS 强制白名单
#   dev   — 开发/测试：show-sql=true、Actuator 详情、DEBUG 日志
#   local — 本地 IDE：H2 + Caffeine（不接 Nacos / MySQL / Redis）
# 公共配置在 application.yml 中通过下列 env 变量控制；profile 只装"不一样"的部分。
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# Nacos 注册 / 配置中心（容器内通过服务名 nacos 解析）
# -----------------------------------------------------------------------------
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# -----------------------------------------------------------------------------
# Sentinel Dashboard（开发环境单机，容器服务名 sentinel-dashboard:8858）
# - 控制台浏览器访问：http://localhost:8858（默认账号 sentinel/sentinel）
# - 留空可禁用上报（client 不连，规则纯本地）
# - docker-compose.yml 中 gateway 已 environment 强约束此值，此处主要服务于其他业务服务
# -----------------------------------------------------------------------------
SENTINEL_DASHBOARD=sentinel-dashboard:8858

# -----------------------------------------------------------------------------
# RocketMQ NameServer（开发环境单机，容器服务名 rocketmq-namesrv:9876）
# - 客户端通过此地址发现 Broker；Broker 启动后向其注册
# - Broker 在容器网络内监听 10911（客户端读写）/ 10909（VIP）/ 10912（HA）
# - autoCreateTopicEnable=true（broker.conf 内联）：开发期允许首次发送时自动建 Topic
# -----------------------------------------------------------------------------
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876

# -----------------------------------------------------------------------------
# Gateway 内部转发地址（容器间走服务名）
# system 服务在容器网络内监听 80（见 application.yml: server.port: 80）
# -----------------------------------------------------------------------------
AUTH_SERVER_URL=http://system:80

# -----------------------------------------------------------------------------
# OAuth2 / Swagger 回调地址（浏览器访问的对外地址，按服务器域名/公网 IP 改）
# -----------------------------------------------------------------------------
SYSTEM_SERVER_URL=http://localhost:80
GATEWAY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# 系统初始管理员（*必填*：application.yml 无默认值，缺失会启动失败）
# -----------------------------------------------------------------------------
EAGLE_ADMIN_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# JWT keystore（生产强烈建议覆盖；默认值仅适合开发）
# -----------------------------------------------------------------------------
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
EAGLE_JWT_KEYSTORE_PASSWORD=eagle-jwt-dev-2026

# -----------------------------------------------------------------------------
# 微信集成（用到对应登录方式才需要填，否则保持空）
# -----------------------------------------------------------------------------
# 小程序
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# 网站应用（PC 扫码）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
# 公众号 H5
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# -----------------------------------------------------------------------------
# 阿里云短信（用到 SMS 登录才需要填）
# -----------------------------------------------------------------------------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# -----------------------------------------------------------------------------
# 数据库 / 缓存连接（application-prod.yml / application-dev.yml 均通过这些 env 注入）
# 容器内访问 mysql / redis 走 docker compose 服务名（不是宿主 IP）
# -----------------------------------------------------------------------------
# MySQL（与 docker-compose.yml 中 mysql 服务的凭证保持一致）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eagle
DB_USERNAME=root
DB_PASSWORD=root123456
# 连接池（可调）
DB_POOL_MAX=50
DB_POOL_MIN=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456
REDIS_DATABASE=0

# -----------------------------------------------------------------------------
# Gateway 生产 CORS 白名单（仅 prod profile 必填）
# 多个域名逗号分隔；与 allowCredentials=true 联用时禁止使用 "*"
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
