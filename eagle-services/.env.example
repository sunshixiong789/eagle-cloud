# =============================================================================
# Eagle Cloud · Docker Compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 适用：在服务器/容器主机上用 docker compose 部署 eagle-services 时使用
# 区别：项目根 /.env.example 用于本地 IDE 开发（host 都是 localhost）；
#       本文件用于容器化部署（host 走 docker compose 服务名）
#
# 用法：
#   1) cd eagle-services
#   2) cp .env.example .env
#   3) 按顺序处理：先填【必填】区，再按需开启【可选】区，【默认即可】区一般不动
#   4) docker compose up -d
# 注意：.env 已被 .gitignore 阻挡，不要提交到仓库
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# [必填] 部署前必须替换的值（不改会启动失败或存在安全风险）
# ─────────────────────────────────────────────────────────────────────────────

# 系统初始管理员密码 —— application.yml 无默认值，缺失会启动失败
EAGLE_ADMIN_PASSWORD=change-me-strong-password

# OAuth2 / Swagger 对外回调地址 —— 浏览器访问的地址，按服务器域名 / 公网 IP 改
SYSTEM_SERVER_URL=http://localhost:8082
GATEWAY_URL=http://localhost:8080

# JWT keystore 密码 —— 默认值仅适合开发，生产强烈建议覆盖
EAGLE_JWT_KEYSTORE_PASSWORD=eagle-jwt-dev-2026

# Gateway CORS 白名单 —— prod profile 必填；多域名逗号分隔；与 allowCredentials=true 联用时禁止 "*"
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# MySQL / Redis 密码 —— 生产请改为高强度密码（docker-compose healthcheck 会自动跟随）
DB_PASSWORD=root123456
REDIS_PASSWORD=redis123456


# ─────────────────────────────────────────────────────────────────────────────
# [可选] 按需启用功能时填写，留空表示禁用对应渠道
# ─────────────────────────────────────────────────────────────────────────────

# 微信小程序登录
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 微信网站应用（PC 扫码登录）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback

# 微信公众号 H5
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# 阿里云短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=


# ─────────────────────────────────────────────────────────────────────────────
# [默认即可] 容器内网拓扑 / 连接细节 —— 通常无需修改
# ─────────────────────────────────────────────────────────────────────────────

# Spring profile：prod 生产 / dev 开发 / local 本地 IDE
SPRING_PROFILES_ACTIVE=prod

# Nacos 注册 / 配置中心（容器内通过服务名解析）
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
# Nacos 3.0+ 默认开启鉴权；首次进入控制台会强制改密，请同步更新此处
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Sentinel Dashboard（容器内通过服务名解析；留空 = 客户端不上报，规则纯本地）
SENTINEL_DASHBOARD=sentinel-dashboard:8858

# RocketMQ NameServer（容器内通过服务名解析）
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876

# Gateway → System 内部转发地址（容器间走服务名 + 容器内监听端口 8082）
AUTH_SERVER_URL=http://system:8082

# MySQL 连接细节（与 docker-compose.yml 中 mysql 服务保持一致）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eagle
DB_USERNAME=root
DB_POOL_MAX=50
DB_POOL_MIN=10

# Redis 连接细节
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# JWT keystore 文件路径 —— 一般保留默认
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
