# =============================================================================
# Eagle Cloud · Docker Compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 适用：在服务器/容器主机上用 docker compose 部署 eagle-services 时使用
# 区别：项目根 /.env.example 用于本地 IDE 开发（host 都是 localhost）；
#       本文件用于容器化部署（host 走 docker compose 服务名）
#
# 用法：
#   1) cd eagle-services
#   2) cp .env.example .env
#   3) 按顺序处理：先填【必填】区，再按需开启【可选】区，【默认即可】区一般不动
#   4) docker compose up -d
# 注意：.env 已被 .gitignore 阻挡，不要提交到仓库
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# [必填] 部署前必须替换的值（不改会启动失败或存在安全风险）
# ─────────────────────────────────────────────────────────────────────────────

# 系统初始管理员 —— auth-service 启动时创建初始 admin Account,
# 同时通过 RocketMQ 事件 → system-service 创建 admin User 并装上 admin 角色。
# 两个服务读同一组环境变量,确保"哪个 username 是管理员"判定一致。
# 仅 PASSWORD 必填(无默认值,缺失即 fail-fast);其它字段省略时走 application.yml 默认值。
EAGLE_ADMIN_PASSWORD=change-me-strong-password
# EAGLE_ADMIN_USERNAME=admin
# EAGLE_ADMIN_NAME=系统管理员
# EAGLE_ADMIN_EMAIL=admin@eagle.com
# EAGLE_ADMIN_PHONE=

# JWT keystore 密码 —— 默认值仅适合开发，生产强烈建议覆盖
EAGLE_JWT_KEYSTORE_PASSWORD=eagle-jwt-dev-2026

# OAuth2 issuer —— JWT iss claim，与资源服务器校验保持一致；集群部署填稳定对外 URL（LB / 网关入口）
EAGLE_OAUTH_ISSUER=http://localhost:8080
# OAuth2 回调白名单 —— 逗号分隔；前端联调 / 多环境部署时补上额外回调地址
EAGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/oauth2/callback
# 资源服务器 JWKS endpoint —— system-service 作为纯资源服务器,直连 auth-service 取公钥(不走 OIDC discovery)
# 容器内默认 http://auth:9090/oauth2/jwks;K8s 部署可改为 lb://eagle-auth-service 或对外稳定 URL
EAGLE_OAUTH_JWK_SET_URI=http://auth:9090/oauth2/jwks

# Gateway CORS 白名单 —— prod profile 必填；多域名逗号分隔；与 allowCredentials=true 联用时禁止 "*"
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# PostgreSQL / Redis 密码 —— 生产请改为高强度密码（docker-compose 中 postgres 与 system 服务共用 DB_PASSWORD）
DB_PASSWORD=eagle123456
REDIS_PASSWORD=redis123456


# ─────────────────────────────────────────────────────────────────────────────
# [可选] 按需启用功能时填写，留空表示禁用对应渠道
# ─────────────────────────────────────────────────────────────────────────────

# 微信开放平台 APP SDK 登录（auth-service 专用，区别于小程序）
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=

# 微信小程序登录
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 微信网站应用（PC 扫码登录）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback

# 微信公众号 H5
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# 短信服务商：aliyun / tencent / hnsls，由 eagle-notification-starter 统一处理
SMS_PROVIDER=hnsls

# 通用短信配置（所有 provider 共用：access-key / sign-name / template-id）
# - SMS_SIGN_NAME 必填，为空时 SmsServiceImpl.isConfigured()=false，验证码只打印日志不发送
# - HNSLS 不使用 access-key / template-id，只需填 SMS_SIGN_NAME + 下方 HNSLS 私有凭证
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# 腾讯云特有（SMS_PROVIDER=tencent 时启用）
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou

# 手拉手特有（SMS_PROVIDER=hnsls 时启用）
HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
HNSLS_SMS_CONTENT_TEMPLATE=您的验证码是{code}，5分钟内有效。
HNSLS_SMS_SEND_URL=https://xapi.hnsls.com.cn/eums/sms/utf8/send.do
HNSLS_SMS_CHARSET=UTF-8
HNSLS_SMS_CONNECT_TIMEOUT_MS=5000
HNSLS_SMS_READ_TIMEOUT_MS=10000


# ─────────────────────────────────────────────────────────────────────────────
# [默认即可] 容器内网拓扑 / 连接细节 —— 通常无需修改
# ─────────────────────────────────────────────────────────────────────────────

# Spring profile：prod 生产 / dev 开发 / local 本地 IDE
SPRING_PROFILES_ACTIVE=prod

# Nacos 注册 / 配置中心（容器内通过服务名解析）
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
# Nacos 3.0+ 默认开启鉴权；首次进入控制台会强制改密，请同步更新此处
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Nacos 注册 IP：单机 docker 部署留空（取容器 IP）；多机部署改为该机器宿主机/公网 IP
NACOS_REGISTER_IP=

# Sentinel Dashboard（容器内通过服务名解析；留空 = 客户端不上报，规则纯本地）
SENTINEL_DASHBOARD=sentinel-dashboard:8858
# Gateway Sentinel 默认限流规则。单机 8G 可先用这组偏高基线，压测后再调整。
EAGLE_GATEWAY_SENTINEL_ENABLED=true
EAGLE_SENTINEL_GLOBAL_QPS=1800
EAGLE_SENTINEL_GLOBAL_BURST=300
EAGLE_SENTINEL_AUTH_QPS=600
EAGLE_SENTINEL_AUTH_BURST=100
EAGLE_SENTINEL_SMS_QPS=80
EAGLE_SENTINEL_SMS_BURST=20

# RocketMQ
#   - ROCKETMQ_ENDPOINTS：5.x gRPC 客户端唯一接入点（system/auth 业务用），必须连 Proxy:8081
#   - ROCKETMQ_NAME_SERVER：4.x 风格 namesrv 地址，仅 gateway 心跳健康检查残留使用
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_ENDPOINTS=rocketmq-proxy:8081
# Topic 环境前缀（推荐通过独立 MQ 集群隔离，留空即可；仅历史 topic 兼容时使用）
ROCKETMQ_TOPIC_ENV_PREFIX=

# Gateway → Auth 内部转发地址（容器间走服务名 + 容器内监听端口 9090；网关本身已通过 Nacos lb 路由）
AUTH_SERVER_URL=http://auth:9090

# PostgreSQL 连接细节（与 docker-compose.yml 中 postgres 服务保持一致）
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eagle_system
# auth-service 独立库（postgres 容器首次启动时由 postgres-init/01-create-auth-db.sh 创建）
AUTH_DB_NAME=eagle_auth
DB_USERNAME=eagle
DB_POOL_MAX=80
DB_POOL_MIN=20

# Redis 连接细节
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_POOL_MAX_ACTIVE=96
REDIS_POOL_MAX_IDLE=32
REDIS_POOL_MIN_IDLE=8
REDIS_POOL_MAX_WAIT=2000ms

# JWT keystore 文件路径 —— 一般保留默认
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
