# =============================================================================
# Eagle Cloud · Docker Compose 部署环境变量模板
# -----------------------------------------------------------------------------
# 适用：在服务器/容器主机上用 docker compose 部署 eagle-services 时使用
# 区别：项目根 /.env.example 用于本地 IDE 开发（host 都是 localhost）；
#       本文件用于容器化部署（host 走 docker compose 服务名）
#
# 用法：
#   1) cd eagle-services
#   2) cp .env.example .env
#   3) 按服务器实际情况修改下方各项（标注 *必填* 的必须替换）
#   4) docker compose up -d
# 注意：.env 已被 .gitignore 阻挡，不要提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# Spring 通用
# -----------------------------------------------------------------------------
# 激活的 profile（与镜像内 application-{profile}.yml 对应；当前 docker 模板尚未
# 提供，设为 docker 仅占位，未来可新增 application-docker.yml 做整段覆盖）
SPRING_PROFILES_ACTIVE=docker

# -----------------------------------------------------------------------------
# Nacos 注册 / 配置中心（容器内通过服务名 nacos 解析）
# -----------------------------------------------------------------------------
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# -----------------------------------------------------------------------------
# Sentinel（当前 compose 未启动 sentinel 容器，留空避免无意义连接超时）
# -----------------------------------------------------------------------------
SENTINEL_DASHBOARD=

# -----------------------------------------------------------------------------
# Gateway 内部转发地址（容器间走服务名）
# system 服务在容器网络内监听 80（见 application.yml: server.port: 80）
# -----------------------------------------------------------------------------
AUTH_SERVER_URL=http://system:80

# -----------------------------------------------------------------------------
# OAuth2 / Swagger 回调地址（浏览器访问的对外地址，按服务器域名/公网 IP 改）
# -----------------------------------------------------------------------------
SYSTEM_SERVER_URL=http://localhost:80
GATEWAY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# 系统初始管理员（*必填*：application.yml 无默认值，缺失会启动失败）
# -----------------------------------------------------------------------------
EAGLE_ADMIN_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# JWT keystore（生产强烈建议覆盖；默认值仅适合开发）
# -----------------------------------------------------------------------------
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
EAGLE_JWT_KEYSTORE_PASSWORD=change-me-jwt-keystore-password

# -----------------------------------------------------------------------------
# 微信集成（用到对应登录方式才需要填，否则保持空）
# -----------------------------------------------------------------------------
# 小程序
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# 网站应用（PC 扫码）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
# 公众号 H5
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# -----------------------------------------------------------------------------
# 阿里云短信（用到 SMS 登录才需要填）
# -----------------------------------------------------------------------------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# -----------------------------------------------------------------------------
# 中间件连接（多数走 Nacos 配置中心更合适；如需容器层覆盖才解开注释）
# 容器内访问：mysql / redis 走服务名
# -----------------------------------------------------------------------------
# MySQL（与 docker-compose.yml 中 mysql 服务的 root 凭证保持一致）
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/eagle?useSSL=false&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root123456
# Redis
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=redis123456
