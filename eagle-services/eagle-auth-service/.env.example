# =============================================================================
# Eagle Auth Service · 本地开发环境变量样例
# =============================================================================
# 复制为 .env 后填入实际值。.env 已在仓库根 .gitignore 中,不会被提交。
# spring-dotenv 启动期自动加载到 Spring Environment。
#
# 字段分三档:
#   [必填]  - 不提供启动会失败或鉴权无法工作
#   [选填]  - 有默认值,本地常可省略
#   [生产]  - 仅生产环境需要覆盖
# =============================================================================

# -------- Spring profile -----------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -------- 服务端口 -----------------------------------------------------------
SERVER_PORT=9090

# -------- 初始管理员(必填) ---------------------------------------------------
# [必填] AdminInitializer 启动时用此密码创建管理员账号,AdminProperties 无默认值缺失即 fail-fast
# [生产] 务必通过 K8s Secret 注入,长度 ≥ 8 位
EAGLE_ADMIN_USERNAME=admin
EAGLE_ADMIN_PASSWORD=changeme
EAGLE_ADMIN_NAME=系统管理员
EAGLE_ADMIN_EMAIL=admin@eagle.com

# -------- JWT 签名密钥(必填) -------------------------------------------------
# [必填] keystore-location: jwt-keystore.p12 的密码,无默认值,缺失即启动失败
# [生产] 应从 K8s Secret 注入,而非环境文件;keystore 文件本身也应走 Volume 挂载
#        而不是打入镜像(见审计 #2)
EAGLE_JWT_KEYSTORE_PASSWORD=changeme

# -------- OAuth2 发行方(必填) ------------------------------------------------
# [必填] JWT iss claim,资源服务器校验时要求一致
EAGLE_OAUTH_ISSUER=http://localhost:9090
# [选填] 允许的 OAuth2 redirect_uri 列表(逗号分隔)
EAGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/oauth2/callback
# [选填] OIDC RP-Initiated Logout 回跳白名单(逗号分隔)
EAGLE_OAUTH_POST_LOGOUT_REDIRECT_URIS=http://localhost:8000/auth/oauth2/logout/callback

# -------- 数据库: PostgreSQL -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eagle_auth
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5

# -------- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# -------- Nacos 注册中心 -----------------------------------------------------
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# [选填] 注册到 Nacos 的 IP,跨主机部署时填本机外网 IP
NACOS_REGISTER_IP=

# -------- RocketMQ -----------------------------------------------------------
ROCKETMQ_ENDPOINTS=localhost:8081
# [选填] topic 环境前缀(为空表示不加前缀)。
# 注意:rules/15-messaging.md 推荐"环境靠不同 MQ 集群隔离,topic 不带 env 前缀";
# 此前缀仅供已存在的历史 topic 临时兼容,新 topic 不要依赖。
ROCKETMQ_TOPIC_ENV_PREFIX=

# -------- 微信登录(选填,按使用渠道填写) -------------------------------------
# App SDK 登录
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
# 小程序登录
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# PC 扫码
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
# H5 公众号
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# -------- 淘宝授权登录(选填,启用淘宝一键登录时填写) ---------------------------
# 前端百川 SDK 用「百川应用 appKey」换 TOP access_token,走 taobao_app 授权类型,
# TaobaoServiceImpl 把该 access_token 当 session 调 taobao.openuid.get 取 open_uid。
# enabled=false 时不装配 TaobaoClient,taobao_app 授权会报 TAOBAO_UPSTREAM。
TAOBAO_APP_ENABLED=false
# ⚠️ 必须填「百川控制台的百川应用」appKey/secret,即与前端 ALIBC_OPEN_APP_KEY 同一个应用。
# 它与 ease-mind-servers/user-service 的 TAOBAO_TOP_APP_KEY(淘宝联盟应用)是【两个不同应用】,
# appKey 不互通。TOP session 只对签发它的 appKey 有效:客户端用百川 appKey 换 token,后端必须用
# 同一个 appKey 调 taobao.openuid.get,否则报 code=27 invalid-sessionkey(SessionKey非法/Invalid session)。
# 另需在百川/开放平台控制台为该应用开通 taobao.openuid.get 的 API 权限。
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# [选填] 签名算法 md5 / hmac-sha256,默认 md5
TAOBAO_APP_SIGN_METHOD=md5

# -------- Apple 登录（启用时全部必填） ---------------------------------------
# 标准服务端 authorization-code flow：后端生成 client_secret，向 Apple 换取并保存 refresh_token。
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=com.shengxinfast.app
APPLE_TEAM_ID=NBSUMG9U89
APPLE_KEY_ID=
# .p8 PEM 内容使用 \n 转义；真实私钥只放 Secret / 本机未跟踪 .env。
APPLE_PRIVATE_KEY=
# refresh_token 字段级加密密钥；APPLE_AUTH_ENABLED=true 时强制要求。
# EAGLE_ENCRYPT_SECRET_KEY=replace-with-local-high-entropy-key

# -------- 短信服务(选填,按 provider 填写) -----------------------------------
SMS_PROVIDER=hnsls
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
# 腾讯云 SMS
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 湖南声立时短信
HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
