# =============================================================================
# Eagle Auth Service · 本地开发环境变量样例
# =============================================================================
# 复制为 .env 后填入实际值。.env 已在仓库根 .gitignore 中,不会被提交。
# spring-dotenv 启动期自动加载到 Spring Environment。
#
# 字段分三档:
#   [必填]  - 不提供启动会失败或鉴权无法工作
#   [选填]  - 有默认值,本地常可省略
#   [生产]  - 仅生产环境需要覆盖
# =============================================================================

# -------- Spring profile -----------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -------- 服务端口 -----------------------------------------------------------
SERVER_PORT=9090

# -------- 初始管理员(必填) ---------------------------------------------------
# [必填] AdminInitializer 启动时用此密码创建管理员账号,AdminProperties 无默认值缺失即 fail-fast
# [生产] 务必通过 K8s Secret 注入,长度 ≥ 8 位
EAGLE_ADMIN_USERNAME=admin
EAGLE_ADMIN_PASSWORD=changeme
EAGLE_ADMIN_NAME=系统管理员
EAGLE_ADMIN_EMAIL=admin@eagle.com

# -------- JWT 签名密钥(必填) -------------------------------------------------
# [必填] keystore-location: jwt-keystore.p12 的密码,无默认值,缺失即启动失败
# [生产] 应从 K8s Secret 注入,而非环境文件;keystore 文件本身也应走 Volume 挂载
#        而不是打入镜像(见审计 #2)
EAGLE_JWT_KEYSTORE_PASSWORD=changeme

# -------- OAuth2 发行方(必填) ------------------------------------------------
# [必填] JWT iss claim,资源服务器校验时要求一致
EAGLE_OAUTH_ISSUER=http://localhost:9090
# [选填] 允许的 OAuth2 redirect_uri 列表(逗号分隔)
EAGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/oauth2/callback

# -------- 数据库: PostgreSQL -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eagle_auth
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5

# -------- Redis --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# -------- Nacos 注册中心 -----------------------------------------------------
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# [选填] 注册到 Nacos 的 IP,跨主机部署时填本机外网 IP
NACOS_REGISTER_IP=

# -------- RocketMQ -----------------------------------------------------------
ROCKETMQ_ENDPOINTS=localhost:8081
# [选填] topic 环境前缀(为空表示不加前缀)。
# 注意:rules/15-messaging.md 推荐"环境靠不同 MQ 集群隔离,topic 不带 env 前缀";
# 此前缀仅供已存在的历史 topic 临时兼容,新 topic 不要依赖。
ROCKETMQ_TOPIC_ENV_PREFIX=

# -------- 微信登录(选填,按使用渠道填写) -------------------------------------
# App SDK 登录
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
# 小程序登录
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# PC 扫码
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
# H5 公众号
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# -------- 短信服务(选填,按 provider 填写) -----------------------------------
SMS_PROVIDER=hnsls
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
# 腾讯云 SMS
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 湖南声立时短信
HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
