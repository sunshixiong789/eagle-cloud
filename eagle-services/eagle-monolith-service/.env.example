# =============================================================================
# Eagle Monolith Service environment variable template
# =============================================================================
# Usage:
#   cd eagle-services/eagle-monolith-service
#   cp .env.example .env
#   adjust values, then run:
#   gradle :eagle-services:eagle-monolith-service:bootRun
#
# .env is ignored by Git. Do not commit real credentials.
# =============================================================================

# -------- Runtime ------------------------------------------------------------
# local           -> H2 + Caffeine
# prod,mysql      -> MySQL + Redis
# prod,postgresql -> PostgreSQL + Redis
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=80
EAGLE_SERVER_URL=http://localhost:80

# -------- Initial admin account ---------------------------------------------
EAGLE_ADMIN_USERNAME=admin
EAGLE_ADMIN_PASSWORD=localDev@2026
EAGLE_ADMIN_NAME=System Administrator
EAGLE_ADMIN_EMAIL=admin@eagle.com
EAGLE_ADMIN_PHONE=

# -------- JWT / OAuth2 -------------------------------------------------------
EAGLE_JWT_KEYSTORE_LOCATION=classpath:jwt-keystore.p12
EAGLE_JWT_KEYSTORE_PASSWORD=eagle-jwt-dev-2026
EAGLE_JWT_KEY_ALIAS=eagle-jwt
EAGLE_OAUTH_ISSUER=http://localhost:80
EAGLE_OAUTH_REDIRECT_URIS=http://localhost:8080/auth/oauth2/callback,http://localhost:80/swagger-ui/oauth2-redirect.html,http://localhost:8000/auth/oauth2/callback

EAGLE_OAUTH_WEB_CLIENT_ID=eagleWeb
EAGLE_OAUTH_WEB_CLIENT_NAME=Eagle Web
EAGLE_OAUTH_WEB_CLIENT_REQUIRE_PKCE=true
EAGLE_OAUTH_APP_CLIENT_ID=eagleApp
EAGLE_OAUTH_APP_CLIENT_NAME=Eagle App

# -------- Local H2 -----------------------------------------------------------
H2_DB_NAME=eagle
H2_DB_USERNAME=root
H2_DB_PASSWORD=123456

# -------- MySQL / PostgreSQL -------------------------------------------------
# Used when SPRING_PROFILES_ACTIVE contains mysql or postgresql.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eagle_monolith
DB_USERNAME=eagle
DB_PASSWORD=change-me-db-password
DB_POOL_MAX=50
DB_POOL_MIN=10

# For PostgreSQL, set:
# SPRING_PROFILES_ACTIVE=prod,postgresql
# DB_PORT=5432

# -------- Redis, used by prod profile ---------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DATABASE=0
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=2000ms

# -------- WeChat login, optional --------------------------------------------
WECHAT_APP_APP_ID=
WECHAT_APP_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost/login/wechat/pc/callback
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_REDIRECT_URI=http://localhost/login/wechat/h5/callback

# -------- SMS provider, optional --------------------------------------------
# Supported values: aliyun / tencent / hnsls. Empty disables real SMS sending.
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_REGION=ap-guangzhou

HNSLS_SMS_USERNAME=
HNSLS_SMS_PASSWORD=
HNSLS_SMS_CONTENT_TEMPLATE=Your verification code is {code}, valid for 5 minutes.
HNSLS_SMS_SEND_URL=https://xapi.hnsls.com.cn/eums/sms/utf8/send.do
HNSLS_SMS_CHARSET=UTF-8
HNSLS_SMS_CONNECT_TIMEOUT_MS=5000
HNSLS_SMS_READ_TIMEOUT_MS=10000
